# Safe default. Live mode additionally requires both safeguards below.
AEGIS_TRADING_MODE=paper
AEGIS_RUN_ONCE=false
AEGIS_CYCLE_SECONDS=300
AEGIS_ENTRY_WINDOW_START=15:45
AEGIS_ENTRY_WINDOW_END=15:55
AEGIS_STRATEGY_CAPITAL=3600

# QQQ risk governor and PSQ hedge. Observe logs signals but never changes orders.
# After paper validation, set AEGIS_HEDGE_MODE=paper to activate the overlay.
AEGIS_HEDGE_MODE=observe
AEGIS_HEDGE_SYMBOL=PSQ
AEGIS_HEDGE_MODERATE_QQQ_RETURN=-0.01
AEGIS_HEDGE_SEVERE_QQQ_RETURN=-0.015
AEGIS_HEDGE_MODERATE_EXPOSURE_FACTOR=0.50
AEGIS_HEDGE_RATIO=0.25
AEGIS_HEDGE_MIN_REBALANCE_USD=25
AEGIS_HEDGE_REBALANCE_TOLERANCE=0.10

APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Reddit research sensor. It never authorizes trades.
AEGIS_REDDIT_ENABLED=false
AEGIS_REDDIT_SCAN_SECONDS=900
AEGIS_REDDIT_SUBREDDITS=wallstreetbets,stocks,options
AEGIS_REDDIT_POST_LIMIT=100
AEGIS_REDDIT_LOOKBACK_MINUTES=120
AEGIS_REDDIT_MIN_MENTIONS=3
AEGIS_REDDIT_MIN_SENTIMENT=0.35
AEGIS_REDDIT_MIN_SPIKE_RATIO=1.5
AEGIS_REDDIT_BASELINE_SAMPLES=12
AEGIS_REDDIT_COOLDOWN_MINUTES=240
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=aegis-research/1.0 by u/YOUR_REDDIT_USERNAME

# Leave these unset in paper trading.
# AEGIS_LIVE_AUTHORIZED=false
# APCA_ACCOUNT_ID=
# AEGIS_APPROVED_LIVE_ACCOUNT_ID=

SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=
